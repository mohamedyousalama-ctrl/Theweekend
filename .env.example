# Dedicated Weekend/Rakan configuration — NAMES ONLY. Never commit values.
# Missing required values must make the application fail explicitly at start (docs/16-C-BASELINE.md §5).
WEEKEND_ENV=                      # local | owner-review
WEEKEND_MODEL_MODE=               # real | mock   (mock is allowed only when WEEKEND_ENV=local and tests run)
WEEKEND_MODEL_PROVIDER=           # anthropic  (the Rakan adapter supports the Claude API only; owner decision D8)
WEEKEND_MODEL_ID=                 # e.g. claude-opus-5 (default per Claude API docs) or claude-sonnet-5 (cheaper); verified in src/contracts/MODEL-CANDIDATES.md
WEEKEND_VISION_MODEL_ID=          # same id as WEEKEND_MODEL_ID (the chat model reads the photo); kept for the config contract
WEEKEND_MODEL_API_KEY=            # private; project-only key; never a Kivo key
WEEKEND_SPEND_CAP_USD_PER_DAY=    # hard ceiling; calls stop with MODEL_UNAVAILABLE(BUDGET_EXCEEDED) when reached
WEEKEND_MAX_CALLS_PER_SESSION=    # hard ceiling per customer session
WEEKEND_REQUEST_TIMEOUT_MS=       # model call timeout
WEEKEND_PHOTO_ENABLED=            # true | false  (false until permitted test subjects and processing controls exist)
WEEKEND_UPLOAD_MAX_BYTES=         # upload gateway limit
WEEKEND_BOOKING_HANDOFF_MODE=     # official_link | pending_request
WEEKEND_OFFICIAL_BOOKING_URL=     # https URL on theweekendhairstyling.com or www.theweekendhairstyling.com only; no credentials, no port
WEEKEND_DB_PATH=                  # path to the dedicated SQLite file (never a shared database)
WEEKEND_SESSION_SECRET=           # private; signs session cookies
WEEKEND_OWNER_PASSCODE_HASH=      # scrypt$salt$hash or legacy 64-char sha256; grants owner-review access, not customer-record authorization
WEEKEND_STAFF_PASSCODE_HASH=      # scrypt$salt$hash or legacy 64-char sha256; staff inbox access for the one M1 branch
WEEKEND_LOCAL_CUSTOMER_PASSCODE_HASH=  # required only when WEEKEND_ENV=local; never a hardcoded passcode
# Plain alternatives accepted at process start and hashed in memory (never logged). Use these on Railway if preferred.
# WEEKEND_OWNER_PASSCODE=
# WEEKEND_STAFF_PASSCODE=
# WEEKEND_LOCAL_CUSTOMER_PASSCODE=
WEEKEND_BRANCH_ID=                # the single M1 branch (owner selection; see research/claude-20260913/ONE-BRANCH-CANDIDATE.md)
WEEKEND_TRUST_PROXY=              # 0 locally; 1 on Railway (the platform proxy appends the client address to X-Forwarded-For)
# WEEKEND_PUBLIC_GUEST=           # optional; true | false. Default false everywhere: customer sessions need the owner passcode. Set true on purpose only (passcode-free try chat = a public paid endpoint; needs the guest limits of package C4). Staff/owner pages always need the team passcode.
# WEEKEND_GUEST_SESSIONS_PER_10MIN=  # optional; public-guest session creates per client address per 10 minutes. Default 5. Further creates are session.throttled.
# WEEKEND_GUEST_TURNS_PER_MIN=     # optional; public-guest paid turns per client address per minute. Default 6. Further turns are 429 session.throttled.
# WEEKEND_OWNER_RESERVED_USD_PER_DAY=  # optional; USD slice of the daily cap reserved for owner/staff. Default 20% of WEEKEND_SPEND_CAP_USD_PER_DAY. Guest spend cannot enter this slice.
# WEEKEND_GUEST_UPLOADS_PER_DAY=    # optional; public-guest photo uploads per client address per UTC day. Default 3. Further uploads are upload.rejected. Guest vision calls count against the guest spend share.
