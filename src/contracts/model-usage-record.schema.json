{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-usage-record.schema.json",
  "title": "ModelUsageRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "usage_id",
    "session_id",
    "turn_id",
    "provider",
    "model_id",
    "prompt_version",
    "input_tokens",
    "output_tokens",
    "latency_ms",
    "cost_estimate_minor",
    "outcome",
    "created_at"
  ],
  "properties": {
    "contract_version": { "const": "0.1.0" },
    "usage_id": { "type": "string", "pattern": "^use_[A-Za-z0-9_-]{1,80}$" },
    "session_id": { "type": "string", "pattern": "^ses_[A-Za-z0-9_-]{1,80}$" },
    "turn_id": { "type": "string", "format": "uuid" },
    "provider": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,40}$" },
    "model_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "prompt_version": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,40}$" },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "cost_estimate_minor": { "type": ["integer", "null"], "minimum": 0 },
    "outcome": { "type": "string", "enum": ["ok", "error", "timeout", "budget"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
